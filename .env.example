# macOS ISO Builder — environment template.
#
# Copy to .env and fill in the values. Never commit .env; it is gitignored.
# Production secrets live in Cerulean Vault (KV v2) and are referenced as
# vault://<mount>/<path>#<KEY> by the stack that resolves them.
#
# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are
# Cerulean and NPM Edge. This repo does not implement any of the three.

# Installer name to download (empty = newest)
MACOS_INSTALLER=

# Where the ISO and DMG are written
OUTPUT_DIR=./out

# Where a hosted deployment keeps secrets
CERULEAN_VAULT_PATH=cerulean/data/ontrak
